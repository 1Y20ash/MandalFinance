FLASK_APP=server.py
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production
DATABASE_URL=sqlite:///ashtavinayak_mandal.db
# Production: postgresql://...

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=mandal-financial-documents
SUPABASE_STORAGE_PRIVATE=true

# Development may use mock; production MUST use razorpay.
PAYMENT_GATEWAY_DRIVER=mock
ONLINE_DONATION_ACCOUNT_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Application logging: INFO is the production default.
LOG_LEVEL=INFO

# Production: shared persistent Redis storage is required for rate limiting.
# Use a managed Redis connection string; never use memory:// in production.
RATELIMIT_STORAGE_URI=redis://localhost:6379/0
# Alternatively, the deployment platform's REDIS_URL may be used.
# Non-secret provider identity is required in production for the processor register.
REDIS_PROVIDER_NAME=local-redis

UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
MAX_DOCUMENT_SIZE=10485760
